{
    "name": "shop-ui",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "build": "BUILDER=\"$PWD/src/SprykerShop/Yves/ShopUi/FrontendBuilder\" && cd \"$INIT_CWD\" && node \"$BUILDER/build.mts\" development",
        "build:watch": "BUILDER=\"$PWD/src/SprykerShop/Yves/ShopUi/FrontendBuilder\" && cd \"$INIT_CWD\" && node \"$BUILDER/build.mts\" development-watch",
        "build:production": "BUILDER=\"$PWD/src/SprykerShop/Yves/ShopUi/FrontendBuilder\" && cd \"$INIT_CWD\" && node \"$BUILDER/build.mts\" production",
        "builder:test": "BUILDER=\"$PWD/src/SprykerShop/Yves/ShopUi/FrontendBuilder\" && cd \"$INIT_CWD\" && NODE_OPTIONS=--experimental-vm-modules jest --config \"$BUILDER/jest.config.mjs\"",
        "stylelint": "node ./src/SprykerShop/Yves/ShopUi/FrontendBuilder/libs/lint/stylelint.mts",
        "lint": "BUILDER=\"$PWD/src/SprykerShop/Yves/ShopUi/FrontendBuilder\" && cd \"$INIT_CWD\" && node \"$BUILDER/libs/lint/eslint.mts\" && node \"$BUILDER/libs/typescript/typecheck.mts\"",
        "update:config": "BUILDER=\"$PWD/src/SprykerShop/Yves/ShopUi/FrontendBuilder\" && cd \"$INIT_CWD\" && node \"$BUILDER/libs/typescript/update-configuration.mts\""
    },
    "dependencies": {
        "autonumeric": "~4.10.10",
        "lodash-es": "~4.18.1",
        "password-validator": "~5.3.0"
    },
    "devDependencies": {
        "@babel/core": "~7.29.7",
        "@babel/plugin-transform-class-properties": "~7.25.9",
        "@babel/plugin-transform-runtime": "~7.28.5",
        "@babel/preset-env": "~7.28.5",
        "@babel/preset-typescript": "~7.28.5",
        "@babel/runtime": "~7.29.7",
        "@colordx/core": "~5.6.0",
        "@jest/globals": "~30.5.1",
        "@jsdevtools/file-path-filter": "~3.0.2",
        "@types/node": "~26.4.0",
        "@typescript-eslint/eslint-plugin": "~8.70.1",
        "@typescript-eslint/parser": "~8.70.1",
        "autoprefixer": "~10.5.4",
        "babel-loader": "~10.1.1",
        "chokidar": "~5.0.0",
        "commander": "~15.0.0",
        "compression-webpack-plugin": "~12.0.0",
        "copy-webpack-plugin": "~14.0.0",
        "css-loader": "~7.1.5",
        "css-minimizer-webpack-plugin": "~8.0.0",
        "eslint": "~10.9.1",
        "fast-glob": "~3.3.3",
        "jest": "~30.5.1",
        "mini-css-extract-plugin": "~2.10.2",
        "postcss": "~8.5.26",
        "postcss-loader": "~8.2.1",
        "postcss-selector-parser": "~7.1.6",
        "sass-embedded": "~1.103.1",
        "sass-loader": "~17.0.1",
        "style-dictionary": "~4.4.0",
        "stylelint": "~17.14.1",
        "stylelint-config-standard-scss": "~17.0.0",
        "ts-jest": "~29.4.12",
        "typescript": "~6.0.3",
        "webpack": "~5.110.3",
        "webpack-merge": "~6.0.1"
    }
}
