{#
 #
 #
 # Component API
 #}

{%- define config = {
    name: required,
    jsName: 'js-' ~ config.name,
    tag: 'div'
} -%}

{%- define data = {} -%}
{%- define embed = {} -%}
{%- set qa = qa | default('') -%}

{%- set class = class | default('') -%}
{%- define modifiers = [] -%}
{%- define attributes = {} -%}

{#-
 # The two macros below are the public Component API and are called directly by templates
 # (as `component.renderClass(...)` or, from a child template, `_self.renderClass(...)`).
 # Their logic lives in PHP — see `componentClass`/`componentAttributes` in ShopUiTwigExtension —
 # because a macro invocation is the single most expensive part of rendering a component, and
 # this model renders once per component on the page.
 -#}

{% macro renderClass(name, modifiers, extra) %}
    {{- componentClass(name, modifiers | default([]), extra | default('')) -}}
{%- endmacro -%}

{% macro renderAttributes(attributes) %}
    {{- componentAttributes(attributes | default({})) -}}
{%- endmacro -%}

{% import _self as component %}

{% block component %}
    {% set componentName = config.name %}
    {% set componentJsName = config.jsName %}
    <{{-config.tag}} class="
        {%- if config.name == config.tag and '-' in config.tag -%}custom-element {% endif -%}

        {%- block class -%}
            {{- componentClass(config.name, modifiers, class) -}}
            {% block extraClass %}{% endblock %}
        {%- endblock -%}"

        {{qa(
            'component',
            config.name,
            attributes.name | default,
            attributes.id | default,
            qa
        )}}

        {%- block attributes -%}
            {{- componentAttributes(attributes) -}}
        {%- endblock -%}>
            {%- block body -%}{%- endblock -%}
    </{{-config.tag-}}>
{% endblock -%}
