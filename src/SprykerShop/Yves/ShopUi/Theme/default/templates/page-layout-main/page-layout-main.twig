{% extends template('page-blank') %}

{% define data = {
    isOverlayOpen: false,
    isAjaxHeader: false,
    ajaxCartUrl: '',
} %}

{%- block class -%}js-page-layout-main{%- endblock -%}

{% set mainContentId = 'main-content' %}
{% set navigationId = 'main-navigation' %}

{% block body %}
    {% include molecule('skip-link') with {
        data: {
            href: navigationId,
            text: 'global.skip-to-navigation' | trans,
        },
    } only %}

    {% include molecule('skip-link') with {
        data: {
            href: mainContentId,
            text: 'global.skip-to-content' | trans,
        },
    } only %}

    {% block notifications %}
        {% include organism('notification-area') only %}
    {% endblock %}

    {% block viewport %}
        {% block sidebar %}
            {% include organism('side-drawer') with {
                class: 'is-hidden-lg-xl',
                data: {
                    isAjaxMode: data.isAjaxHeader,
                    ajaxCartUrl: data.ajaxCartUrl,
                },
                attributes: {
                    'container-selector': 'js-page-layout-main',
                    'trigger-selector': 'js-page-layout-main__side-drawer-trigger',
                },
            } only %}
        {% endblock %}

        {% block outside %}
            {% include molecule('outside-widgets') only %}
        {% endblock %}

        {% block header %}
            {% embed organism('header') with {
                data: {
                    isAjaxMode: data.isAjaxHeader,
                    ajaxCartUrl: data.ajaxCartUrl,
                },
                attributes: {
                    navigationId: navigationId,
                },
            } only %}
                {% block mobile %}
                    <a href="#" class="link link--alt js-page-layout-main__side-drawer-trigger">
                        {% include atom('icon') with {
                            modifiers: ['big'],
                            data: {
                                name: 'bars',
                            },
                        } only %}
                    </a>
                {% endblock %}
            {% endembed %}
        {% endblock %}

        <div class="container">
            {% block pageInfo %}
                <div class="box">
                    {% block breadcrumbs %}
                        {% include molecule('breadcrumb') only %}
                    {% endblock %}

                    <hr class="box__separator">

                    {% block title %}
                        <h1 class="title--h3">{{ data.title }}</h1>
                    {% endblock %}
                </div>
            {% endblock %}

            <main id="{{ mainContentId }}">
                {% block content %}{% endblock %}
            </main>

            {% block footer %}
                {% include organism('footer') only %}
            {% endblock %}
        </div>
    {% endblock %}

    {% block globalComponents %}
        {% include molecule('action-single-click-enforcer') with {
            attributes: {
                'target-selector': '[data-init-single-click]',
            },
        } only %}

        {% include molecule('form-input-default-value-disabler') with {
            attributes: {
                'form-selector': '[data-init-default-value-form]',
                'input-selector': '[data-default-value-disabler]',
            },
        } only %}

        {% include molecule('form-submitter') with {
            attributes: {
                'trigger-selector': '[data-form-submitter]',
            },
        } only %}

        {% include molecule('viewport-intersection-observer') only %}

        {% include molecule('main-overlay') with {
            attributes: {
                'is-open': data.isOverlayOpen,
            },
        } only %}

        {% include molecule('traceable-events-google-analytics', 'GoogleAnalytics') ignore missing with {
            data: {
                gtagId: configurationValue('integrations:google_analytics:tracking:measurement_id') | default(null),
            },
        } only %}
    {% endblock %}

    {% block traceableEvent %}
        {% set currency %}
            {% widget 'CurrencyIsoCodeWidget' only %}{% endwidget %}
        {% endset %}

        {# Add to cart is listed before the product click: a click on a product card's add-to-cart button would otherwise count as a click on the card.
           The triggers are the clicked buttons themselves, not focused ones: Safari and Firefox on macOS do not focus a button on click.
           A product card click sends the list the card belongs to and its position in it, as the item list view tracker writes them, so it matches the list view.
           The item list view tracker reports every view with its own products, so none of them is debounced. #}
        {% set events = {
            list: [
                {
                    event: 'PAGE_LOAD',
                    name: 'load',
                },
                {
                    event: 'ITEM_LIST_VIEW',
                    name: 'item-list-view',
                    debounce: false,
                },
                {
                    event: 'ADD_TO_CART',
                    name: 'click',
                    triggers: [
                        {
                            selector: '.js-product-item .js-ajax-add-to-cart__button',
                            groupAs: {
                                key: 'products',
                                toArray: true,
                            },
                            data: {
                                details: {
                                    selector: '.js-product-item',
                                    closest: true,
                                    attribute: 'details',
                                    flatten: true,
                                },
                            },
                        },
                        {
                            selector: '.js-product-item__button-add-to-cart',
                            groupAs: {
                                key: 'products',
                                toArray: true,
                            },
                            data: {
                                details: {
                                    selector: '.js-product-item',
                                    closest: true,
                                    attribute: 'details',
                                    flatten: true,
                                },
                                quantity: {
                                    value: 1,
                                },
                            },
                        },
                        {
                            selector: '.product-set-cms-content [tracking-products]',
                            data: {
                                products: {
                                    selector: 'self',
                                    attribute: 'tracking-products',
                                },
                            },
                        },
                    ],
                },
                {
                    event: 'PRODUCT_CLICK',
                    name: 'click',
                    triggers: [
                        {
                            selector: '.js-product-item',
                            groupAs: {
                                key: 'products',
                                toArray: true,
                            },
                            data: {
                                details: {
                                    selector: 'self',
                                    flatten: true,
                                },
                                itemListId: {
                                    selector: '[data-item-list-id]',
                                    closest: true,
                                    attribute: 'data-item-list-id',
                                },
                                itemListName: {
                                    selector: '[data-item-list-id]',
                                    closest: true,
                                    attribute: 'data-item-list-name',
                                },
                                index: {
                                    selector: 'self',
                                    attribute: 'data-item-list-index',
                                },
                            },
                        },
                        {
                            selector: '.suggestion-product',
                            groupAs: {
                                key: 'products',
                                toArray: true,
                            },
                            data: {
                                sku: {
                                    selector: 'self',
                                },
                                searchId: {
                                    value: null,
                                },
                            },
                        }
                    ],
                },
                {
                    event: 'SEARCH_EVENT',
                    name: 'search-results',
                },
                {
                    event: 'CHECKOUT_START',
                    name: 'click',
                    triggers: [
                        {
                            selector: 'a[href$="/checkout"]',
                        },
                    ],
                },
            ],
            data: {
                currency: currency | spaceless,
            },
        } %}

        {# Reports the product cards seen in lists marked with data-item-list-id, e.g. similar products, as the item-list-view event, and writes each card's position to data-item-list-index, which a product card click sends as `index`. #}
        {% if findWidget('TraceableEventWidget').parameters.isUserActionTrackingEnabled ?? false %}
            {% include molecule('traceable-item-list-view-tracker', 'TraceableEventWidget') ignore missing only %}
        {% endif %}

        {% block eventTracker %}
            {% widget 'TraceableEventWidget' with {
                events: events,
            } only %}
            {% endwidget %}
        {% endblock %}
    {% endblock %}

    {% block icons %}
        {% include atom('icon-sprite') only %}
    {% endblock %}
{% endblock %}
